{
  "name": "read-twice-browser",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "kVadrum",
  "description": "A calm second eye for pages that look off — a free, MIT-licensed browser extension that surfaces plain-language warnings before you click, type, pay, or call.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixtures": "vitest run --config vitest.fixtures.config.ts",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "preact": "^10.29.0",
    "tldts": "^7.4.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.0",
    "@types/chrome": "^0.2.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0"
  }
}
