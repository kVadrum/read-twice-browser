{
  "name": "read-twice-browser",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "kVadrum",
  "description": "A calm second eye for pages that look off — a free, MIT-licensed browser extension that surfaces plain-language warnings before you click, type, pay, or call.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
