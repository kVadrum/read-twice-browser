    "test:watch": "vitest",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.0",
    "@types/chrome": "^0.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
